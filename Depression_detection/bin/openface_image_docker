#!/usr/bin/env bash
set -euo pipefail

input=""
out_dir=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -f)
      input="$2"
      shift 2
      ;;
    -out_dir)
      out_dir="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [[ -z "$input" || -z "$out_dir" ]]; then
  echo "Usage: openface_image_docker -f <image> -out_dir <output_dir>" >&2
  exit 2
fi

mkdir -p "$out_dir"
input_abs="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
out_abs="$(cd "$out_dir" && pwd)"

docker run --rm \
  -v "$(dirname "$input_abs"):/input:ro" \
  -v "$out_abs:/output" \
  algebr/openface:latest \
  /bin/bash -lc "FaceLandmarkImg -f '/input/$(basename "$input_abs")' -out_dir /output || build/bin/FaceLandmarkImg -f '/input/$(basename "$input_abs")' -out_dir /output"
